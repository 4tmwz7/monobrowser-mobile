<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_tab"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_tab"
        android:shortcutShortLabel="@string/shortcut_new_tab">
        <intent
            android:action="com.voluene.monobrowser.action.NEW_TAB"
            android:targetClass="com.voluene.monobrowser.MainActivity"
            android:targetPackage="com.voluene.monobrowser" />
    </shortcut>
    <shortcut
        android:shortcutId="new_private_tab"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_private_tab"
        android:shortcutShortLabel="@string/shortcut_new_private_tab">
        <intent
            android:action="com.voluene.monobrowser.action.NEW_PRIVATE_TAB"
            android:targetClass="com.voluene.monobrowser.MainActivity"
            android:targetPackage="com.voluene.monobrowser" />
    </shortcut>
</shortcuts>
